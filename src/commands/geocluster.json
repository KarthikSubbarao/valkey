{
    "GEOCLUSTER": {
        "summary": "Clusters points in a geospatial index using geohash-based clustering.",
        "complexity": "O(N) where N is the number of elements in the sorted set",
        "group": "geo",
        "since": "9.1.0",
        "arity": -2,
        "function": "geoclusterCommand",
        "command_flags": [
            "READONLY"
        ],
        "acl_categories": [
            "GEO"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO",
                    "ACCESS"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "precision",
                "token": "PRECISION",
                "type": "integer",
                "optional": true
            },
            {
                "name": "count",
                "token": "COUNT", 
                "type": "integer",
                "optional": true
            }
        ]
    }
}